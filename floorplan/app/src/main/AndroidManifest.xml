<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- ARCore-required app: only installable on ARCore-supported devices. -->
    <uses-feature android:name="android.hardware.camera.ar" android:required="true" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:name=".FloorPlanApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FloorPlan">

        <meta-data android:name="com.google.ar.core" android:value="required" />

        <!--
            configChanges: a recreated Activity tears down the ARCore session and its coordinate frame,
            which would split a multi-room scan. The UI is Compose-only and re-reads Configuration on
            onConfigurationChanged, so every change that can plausibly happen mid-scan on a Samsung phone
            is handled in place: dark mode / Bedtime mode (uiMode), screen zoom or resolution (density),
            pop-up view and split screen (smallestScreenSize, screenLayout, screenSize), font size and bold
            text (fontScale, fontWeightAdjustment), a Bluetooth keyboard or HID laser meter (keyboard,
            keyboardHidden, navigation), language (locale, layoutDirection), display color mode, an
            external display or Samsung DeX taking over input (touchscreen), and a SIM / eSIM profile
            switching operator (mcc, mnc).
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|touchscreen|uiMode|density|fontScale|fontWeightAdjustment|locale|layoutDirection|colorMode|mcc|mnc"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.FloorPlan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
